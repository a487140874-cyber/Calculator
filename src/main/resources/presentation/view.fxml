<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="presentation.HelloController"
      stylesheets="@styles.css"
      styleClass="vbox">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>
    <Label fx:id="welcomeText" styleClass="label" text="地质关键层计算器"/>
    <TextField fx:id="excelPathTextField" promptText="导入excel路径" editable="false" styleClass="text-field"/>
    <HBox spacing="10" alignment="CENTER" styleClass="hbox">
        <Button text="数据导入" onAction="#handleImportAction" styleClass="button"/>
        <Button text="模版导出" onAction="#handleExportAction" styleClass="button"/>
        <Button text="计算关键层" onAction="#handleCalculateAction" styleClass="button"/>
    </HBox>
    <TextArea fx:id="logTextArea" promptText="输出日志" styleClass="log-text-area"/>
</VBox>
