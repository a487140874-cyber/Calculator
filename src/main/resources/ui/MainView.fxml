<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
  Layout mirrors the dark "地质岩层计算器" prototype: a title header, a three-column
  main area (flow panel / viewer / selected-layer detail) and a full-width bottom row
  (layer table / import-export + activity log). Views that used to be TabPane tabs are
  now switched by the pill row above the viewer.
-->
<BorderPane fx:id="rootPane" xmlns="http://javafx.com/javafx/11.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.MainController">
    <top>
        <VBox>
            <MenuBar>
                <Menu mnemonicParsing="false" text="File">
                    <MenuItem fx:id="importMenuItem" mnemonicParsing="false" onAction="#handleImportExcel" text="Import from Excel..." />
                    <MenuItem fx:id="exportMenuItem" mnemonicParsing="false" onAction="#handleExportExcel" text="Export to Excel..." />
                    <SeparatorMenuItem mnemonicParsing="false" />
                    <MenuItem mnemonicParsing="false" onAction="#handleExit" text="Exit" />
                </Menu>
                <Menu mnemonicParsing="false" text="Help">
                    <MenuItem mnemonicParsing="false" onAction="#handleAbout" text="About" />
                </Menu>
            </MenuBar>

            <HBox fx:id="appBar" styleClass="app-header" alignment="CENTER_LEFT" spacing="14">
                <VBox spacing="3">
                    <Label styleClass="text-title-lg" text="覆岩关键层分析系统" />
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label fx:id="fileNameLabel" styleClass="text-caption" text="未打开文件" />
                        <Label fx:id="fileBadgeLabel" styleClass="tag, tag-nokey" text="等待导入" />
                    </HBox>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Label styleClass="badge" text="Excel 导入" />
                <Label styleClass="badge" text="内置计算公式" />
                <Label styleClass="badge" text="真实厚度比例" />
                <Button fx:id="themeToggleButton" styleClass="btn-ghost" onAction="#handleToggleTheme" text="浅色模式" />
                <Button fx:id="importButton" styleClass="btn-primary" onAction="#handleImportExcel" text="导入数据" />
                <MenuButton fx:id="exportButton" styleClass="btn-secondary" text="导出结果">
                    <items>
                        <MenuItem text="导出 Excel 结果" onAction="#handleExportExcel" />
                        <MenuItem fx:id="exportImageMenuItem" text="导出三维图片" onAction="#handleExportThreeDImage" />
                    </items>
                </MenuButton>
            </HBox>
        </VBox>
    </top>

    <left>
        <VBox styleClass="app-panel, side-panel" prefWidth="268" minWidth="268" maxWidth="268">
            <VBox styleClass="panel-header" spacing="3">
                <Label styleClass="text-panel-head" text="分析流程面板" />
                <Label styleClass="text-caption" text="按顺序执行：导入 → 关键层 → 垮落 → 能量 → 三维。" wrapText="true" minWidth="0" minHeight="-Infinity" maxWidth="236" />
            </VBox>
            <VBox styleClass="panel-body" spacing="10" VBox.vgrow="ALWAYS">
                <Label styleClass="notice" text="岩层剖面按真实厚度比例自下而上堆叠；计算结果全部由内置地质力学公式得出，不需要手动录入。" wrapText="true" minWidth="0" minHeight="-Infinity" maxWidth="236" />
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS"
                            style="-fx-background: transparent; -fx-background-color: transparent;">
                    <content>
                        <VBox fx:id="stepNav" styleClass="step-nav" spacing="2" />
                    </content>
                </ScrollPane>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox spacing="12">
            <padding><Insets top="12" right="12" bottom="12" left="12" /></padding>

            <HBox fx:id="statCardsBox" spacing="10" />

            <VBox styleClass="app-panel, viewer-panel" VBox.vgrow="ALWAYS">
                <HBox fx:id="viewPillsBox" styleClass="view-pills" spacing="8" alignment="CENTER_LEFT" />
                <StackPane fx:id="viewerStack" VBox.vgrow="ALWAYS">
                    <VBox fx:id="profileViewBox">
                        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS"
                                    style="-fx-background: transparent; -fx-background-color: transparent;">
                            <content>
                                <Pane fx:id="visualizationPane" prefHeight="600.0" />
                            </content>
                        </ScrollPane>
                    </VBox>
                    <VBox fx:id="energyTabBox" alignment="CENTER" spacing="10" />
                    <VBox fx:id="d3TabBox" alignment="CENTER" spacing="12" />
                    <Label fx:id="scaleInfoLabel" styleClass="scale-info, mono-num" StackPane.alignment="BOTTOM_LEFT"
                           mouseTransparent="true" text="">
                        <StackPane.margin><Insets bottom="14" left="14" /></StackPane.margin>
                    </Label>
                </StackPane>
            </VBox>
        </VBox>
    </center>

    <right>
        <VBox fx:id="detailPanel" styleClass="app-panel, side-panel, detail-panel" prefWidth="308" minWidth="308" maxWidth="308">
            <padding><Insets top="14" right="14" bottom="14" left="14" /></padding>
        </VBox>
    </right>

    <bottom>
        <VBox>
            <HBox spacing="12" prefHeight="292" minHeight="292">
                <padding><Insets top="0" right="12" bottom="10" left="12" /></padding>

                <VBox styleClass="app-panel" HBox.hgrow="ALWAYS">
                    <VBox styleClass="panel-header" spacing="3">
                        <Label styleClass="text-panel-head" text="岩层数据表" />
                        <Label styleClass="text-caption" text="序号体现自下而上的堆叠顺序；点击任一行可在右侧查看该层的全部参数与计算结果。" wrapText="true" minWidth="0" minHeight="-Infinity" maxWidth="700" />
                    </VBox>
                    <VBox styleClass="panel-body" spacing="8" VBox.vgrow="ALWAYS">
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <TextField fx:id="searchField" promptText="按岩层名称搜索…" prefWidth="200" />
                            <HBox fx:id="filterBox" spacing="6" alignment="CENTER_LEFT" />
                        </HBox>
                        <TableView fx:id="dataTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="numCol" prefWidth="50.0" text="序号" />
                                <TableColumn fx:id="nameCol" prefWidth="110.0" text="岩层名称" />
                                <TableColumn fx:id="hCol" prefWidth="80.0" text="层厚 H" />
                                <TableColumn fx:id="lCol" prefWidth="80.0" text="体积力 L" />
                                <TableColumn fx:id="eCol" prefWidth="90.0" text="弹性模量 E" />
                                <TableColumn fx:id="rCol" prefWidth="90.0" text="抗拉强度 R" />
                                <TableColumn fx:id="isKeyLayerCol" prefWidth="90.0" text="是否关键层" />
                                <TableColumn fx:id="isNotCrackCol" prefWidth="90.0" text="是否未垮落" />
                                <TableColumn fx:id="lastAiCol" prefWidth="90.0" text="破断步距" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </VBox>
                </VBox>

                <VBox styleClass="app-panel" prefWidth="396" minWidth="396" maxWidth="396">
                    <VBox styleClass="panel-header" spacing="3">
                        <Label styleClass="text-panel-head" text="数据导入 / 导出" />
                        <Label styleClass="text-caption" text="导入 Excel 原始数据，导出计算结果与三维图片。" wrapText="true" minWidth="0" minHeight="-Infinity" maxWidth="360" />
                    </VBox>
                    <VBox styleClass="panel-body" spacing="10" VBox.vgrow="ALWAYS">
                        <HBox spacing="8">
                            <Button styleClass="btn-primary, btn-small" onAction="#handleImportExcel" text="导入 Excel" />
                            <Button fx:id="exportExcelButton" styleClass="btn-secondary, btn-small" onAction="#handleExportExcel" text="导出结果" />
                            <Button fx:id="exportImageButton" styleClass="btn-secondary, btn-small" onAction="#handleExportThreeDImage" text="导出三维图" />
                        </HBox>
                        <Label styleClass="text-caption" text="操作与数据质量记录" />
                        <VBox fx:id="overviewSideBox" VBox.vgrow="ALWAYS" />
                    </VBox>
                </VBox>
            </HBox>

            <HBox styleClass="status-bar" alignment="CENTER_LEFT">
                <Label fx:id="statusLabel" text="就绪，请先导入 Excel 数据文件。" />
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
