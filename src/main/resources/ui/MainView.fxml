<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="rootPane" xmlns="http://javafx.com/javafx/11.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.MainController">
    <top>
        <VBox>
            <MenuBar>
                <Menu mnemonicParsing="false" text="File">
                    <MenuItem fx:id="importMenuItem" mnemonicParsing="false" onAction="#handleImportExcel" text="Import from Excel..." />
                    <MenuItem fx:id="exportMenuItem" mnemonicParsing="false" onAction="#handleExportExcel" text="Export to Excel..." />
                    <SeparatorMenuItem mnemonicParsing="false" />
                    <MenuItem mnemonicParsing="false" onAction="#handleExit" text="Exit" />
                </Menu>
                <Menu mnemonicParsing="false" text="Help">
                    <MenuItem mnemonicParsing="false" onAction="#handleAbout" text="About" />
                </Menu>
            </MenuBar>
            <HBox fx:id="appBar" styleClass="app-bar" alignment="CENTER_LEFT" spacing="12">
                <Label styleClass="text-app-name" text="覆岩关键层分析系统" />
                <Region styleClass="divider" minWidth="1" maxWidth="1" prefHeight="22" style="-fx-background-color: -border;" />
                <Label fx:id="fileNameLabel" styleClass="text-body" text="未打开文件" />
                <Label fx:id="fileBadgeLabel" styleClass="tag, tag-nokey" text="等待导入" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="themeToggleButton" styleClass="btn-ghost" onAction="#handleToggleTheme" text="深色模式" />
                <Button fx:id="importButton" styleClass="btn-primary" onAction="#handleImportExcel" text="导入数据" />
                <MenuButton fx:id="exportButton" styleClass="btn-secondary" text="导出结果">
                    <items>
                        <MenuItem text="导出 Excel 结果" onAction="#handleExportExcel" />
                        <MenuItem fx:id="exportImageMenuItem" text="导出三维图片" onAction="#handleExportThreeDImage" />
                    </items>
                </MenuButton>
            </HBox>
        </VBox>
    </top>

    <left>
        <VBox fx:id="stepNav" styleClass="step-nav" prefWidth="236" minWidth="236" maxWidth="236">
            <padding><Insets top="14" right="10" bottom="12" left="10" /></padding>
        </VBox>
    </left>

    <center>
        <TabPane fx:id="workTabs" styleClass="workbench-tabs" tabClosingPolicy="UNAVAILABLE" BorderPane.alignment="CENTER">
            <Tab fx:id="overviewTab" text="概览">
                <content>
                    <VBox spacing="12">
                        <padding><Insets top="14" right="14" bottom="14" left="14" /></padding>
                        <HBox fx:id="statCardsBox" spacing="10" />
                        <SplitPane dividerPositions="0.72" VBox.vgrow="ALWAYS">
                            <VBox styleClass="app-panel">
                                <Label styleClass="text-panel-head" text="岩层剖面">
                                    <padding><Insets top="10" right="12" bottom="10" left="12" /></padding>
                                </Label>
                                <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS" style="-fx-background: transparent; -fx-background-color: transparent;">
                                    <content>
                                        <Pane fx:id="visualizationPane" prefHeight="600.0" style="-fx-background-color: -panel-white;" />
                                    </content>
                                </ScrollPane>
                            </VBox>
                            <VBox fx:id="overviewSideBox" spacing="12" />
                        </SplitPane>
                    </VBox>
                </content>
            </Tab>

            <Tab fx:id="tableTab" text="数据表">
                <content>
                    <VBox spacing="10">
                        <padding><Insets top="14" right="14" bottom="14" left="14" /></padding>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <TextField fx:id="searchField" promptText="按岩层名称搜索…" prefWidth="220" />
                        </HBox>
                        <HBox fx:id="filterBox" spacing="6" />
                        <TableView fx:id="dataTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="numCol" prefWidth="50.0" text="Num" />
                                <TableColumn fx:id="nameCol" prefWidth="120.0" text="Name" />
                                <TableColumn fx:id="hCol" prefWidth="75.0" text="H (Thickness)" />
                                <TableColumn fx:id="lCol" prefWidth="75.0" text="L (Volume)" />
                                <TableColumn fx:id="eCol" prefWidth="100.0" text="E (Elasticity)" />
                                <TableColumn fx:id="rCol" prefWidth="100.0" text="R (Tensile)" />
                                <TableColumn fx:id="isKeyLayerCol" prefWidth="100.0" text="Is Key Layer?" />
                                <TableColumn fx:id="isNotCrackCol" prefWidth="100.0" text="Remains Stable?" />
                                <TableColumn fx:id="lastAiCol" prefWidth="100.0" text="Fracture Dist." />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </VBox>
                </content>
            </Tab>

            <Tab fx:id="energyTab" text="能量分析">
                <content>
                    <VBox fx:id="energyTabBox" alignment="CENTER" spacing="10">
                        <Label styleClass="text-soft" text="尚无能量计算结果" />
                    </VBox>
                </content>
            </Tab>

            <Tab fx:id="d3Tab" text="三维视图">
                <content>
                    <VBox fx:id="d3TabBox" alignment="CENTER" spacing="12" />
                </content>
            </Tab>
        </TabPane>
    </center>

    <right>
        <VBox fx:id="detailPanel" styleClass="detail-panel" prefWidth="304" minWidth="304" maxWidth="304">
            <padding><Insets top="24" right="14" bottom="24" left="14" /></padding>
            <Label styleClass="text-soft" text="尚未选中岩层" wrapText="true" />
        </VBox>
    </right>

    <bottom>
        <HBox styleClass="status-bar" alignment="CENTER_LEFT">
            <Label fx:id="statusLabel" text="Status: Ready. Please import an Excel file to begin." />
        </HBox>
    </bottom>
</BorderPane>
